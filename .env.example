# Variables del frontend (Vite). Copia este archivo a .env.local; no lo versiones.
# Solo las variables con prefijo VITE_ llegan al navegador: nunca pongas secretos aquí.

# URL base de la API (sin barra final). Vacío = http://localhost:3000/api/v1
VITE_API_URL=

# Pon true para mostrar los botones de acceso de invitado en el login (solo demo).
VITE_ENABLE_GUEST=
