# Copia este archivo a .env y completa los valores. NO versiones .env.

# Obligatorio. Mínimo 32 caracteres aleatorios. Si falta o es corto, el servidor no arranca.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Costo de bcrypt (4-15). Si se deja vacío se usa 10.
BCRYPT_COST=

# Orígenes permitidos por CORS, separados por comas (ej. http://localhost:5173). Vacío = ninguno.
CORS_ORIGINS=

# Pon true para cargar usuarios, items y mascotas de ejemplo (solo desarrollo).
# Las contraseñas se generan al azar y se imprimen una vez en la consola. Se ignora si NODE_ENV=production.
SEED_DEMO_DATA=

# Demo pública: pon true para sembrar SOLO el catálogo de ejemplo (un proveedor demo sin
# contraseña conocida). Funciona también con NODE_ENV=production. Los usuarios se registran solos.
DEMO_MODE=

# Tope total de usuarios en memoria (1000 por defecto). Al alcanzarlo, el registro responde 503.
MAX_USERS=

# Entorno (development por defecto). En producción el seed nunca se ejecuta.
NODE_ENV=

# Saltos de proxy de confianza (0 por defecto). Pon 1 si estás detrás de UN proxy
# (Render, Vercel, nginx) para que req.ip sea la IP real del cliente. Con 0, X-Forwarded-For se ignora.
# No lo subas si no hay proxy: un cliente podría falsear su IP y evadir el límite de login.
TRUST_PROXY=

# Puerto HTTP. Si se deja vacío se usa 3000.
PORT=
